{
  "name": "@repo-saga/core",
  "version": "0.1.0",
  "description": "Core analysis engine for repo-saga: git mining, heuristic detectors and era grouping",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist .tsbuildinfo",
    "test": "vitest run",
    "lint": "eslint src --ext .ts --max-warnings 0"
  },
  "dependencies": {
    "execa": "^9.5.1",
    "simple-git": "^3.27.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "rimraf": "^5.0.5",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "license": "MIT"
}
