{
  "name": "@repo-saga/renderer",
  "version": "0.1.0",
  "description": "Renderers for repo-saga: produce JSON, Markdown, and SVG outputs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./i18n": {
      "types": "./dist/i18n.d.ts",
      "import": "./dist/i18n.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist .tsbuildinfo",
    "test": "vitest run",
    "lint": "eslint src --ext .ts --max-warnings 0"
  },
  "dependencies": {
    "@repo-saga/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "rimraf": "^5.0.5",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "license": "MIT"
}
