{
  "name": "@repo-saga/server",
  "version": "0.1.0",
  "description": "Local Fastify server for repo-saga",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist .tsbuildinfo",
    "test": "vitest run",
    "lint": "eslint src --ext .ts --max-warnings 0"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/static": "^7.0.4",
    "@repo-saga/core": "workspace:*",
    "@repo-saga/renderer": "workspace:*",
    "fastify": "^4.28.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "rimraf": "^5.0.5",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "license": "MIT"
}
